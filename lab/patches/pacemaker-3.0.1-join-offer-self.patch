From eede779f7c8c3e665efbaab41be5d75806f7d686 Mon Sep 17 00:00:00 2001
From: Zakinko <zakinko@snowrabbit.org>
Date: Thu, 29 Oct 2026 23:29:40 +0900
Subject: [PATCH] Fix: controller: offer the DC itself when an unknown node
 joins

do_dc_join_offer_one() makes the local node an offer after a join
request, to keep max_generation_from right, but not when it makes
offers because an unknown node joined.  max_generation_from then stays
as it was when the join round began, and a rejoining node whose CIB is
newer becomes the finalization sync source.  If that node is fenced
before finalization (it rejoined while being fenced), finalization has
nobody left to finalize, never syncs, never sets R_HAVE_CIB, and
check_join_state() waits in S_FINALIZE_JOIN until
join-finalization-timeout (30 minutes by default).

Make the local node an offer in that path too.
---
 daemons/controld/controld_join_dc.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/daemons/controld/controld_join_dc.c b/daemons/controld/controld_join_dc.c
index a91fbfa..1d88581 100644
--- a/daemons/controld/controld_join_dc.c
+++ b/daemons/controld/controld_join_dc.c
@@ -356,6 +356,21 @@ do_dc_join_offer_one(long long action,
         crm_info("Making join-%d offers to any unconfirmed nodes "
                  "because an unknown node joined", current_join_id);
         g_hash_table_foreach(pcmk__peer_cache, join_make_offer, &member);
+
+        /* As for a join request below: if an offer went out, make one to the
+         * local node as well.  Otherwise max_generation_from keeps whatever it
+         * was when this join round began, and a node whose CIB is newer than
+         * that becomes the source for the finalization sync.  If that node is
+         * then lost (fenced, say) before finalization, nothing is left to sync
+         * from, R_HAVE_CIB is never set, and the DC waits in S_FINALIZE_JOIN
+         * until join-finalization-timeout.
+         */
+        if (crmd_join_phase_count(controld_join_welcomed) > 0) {
+            member = controld_get_local_node_status();
+            if (controld_get_join_phase(member) != controld_join_welcomed) {
+                join_make_offer(NULL, member, NULL);
+            }
+        }
         check_join_state(cur_state, __func__);
         return;
     }
